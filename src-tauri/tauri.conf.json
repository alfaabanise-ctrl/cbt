

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cbt",
  "version": "0.1.0",
  "identifier": "com.virex.cbt",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "ExamTips",
        "url": "http://localhost:3000/splash",

        "width": 850,
        "height": 480,

        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,

        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "CBT - ExamTips",
        "width": 200,
        "height": 444,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "fullscreen": false,
        "center": true,
       

        "visible": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "resources": [
      "resources/dictionary.db",
      "resources/questions.db",
      "resources/lessons.db"
    ],

    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}